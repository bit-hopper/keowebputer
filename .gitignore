node_modules/
# the built extension package (about 70 MB, regenerated by extension/build.js)
dist/
*.log
# one-off probes and the first prototype: kept locally for reference, not published
research/
# private working notes and instructions for the assistant: every markdown file except the README
*.md
!README.md
!THIRD-PARTY-NOTICES.md

# cache of a snapshot refresh (transpiled kernel files, linked kernel root); a package build does not write it
.cache/
